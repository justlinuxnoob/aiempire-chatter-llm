# Settings for the RunPod worker (become `vllm serve` flags inside the worker).
# No secrets here — this file is committed. Change a value, then run
# scripts/create_endpoint.py --update to push it to RunPod.

MODEL_NAME=shawnw3i/Huihui-Qwen3.6-27B-abliterated-AWQ-MTP
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.92
ENABLE_AUTO_TOOL_CHOICE=true
TOOL_CALL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_PREFIX_CACHING=true
MAX_NUM_SEQS=16
OPENAI_SERVED_MODEL_NAME_OVERRIDE=chatter
